# Port the Express server listens on
PORT=3000

# Stripe secret key (test or live) - never commit the real value
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret - from the Stripe Dashboard (or `stripe listen`
# locally). Required to verify /api/webhooks/stripe requests are really from Stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Where Stripe redirects after a successful / cancelled Checkout
WEBFLOW_SUCCESS_URL=https://yoursite.webflow.io/thank-you
WEBFLOW_CANCEL_URL=https://yoursite.webflow.io/quote

# HubSpot private app access token (Settings > Integrations > Private Apps).
# Needs CRM scopes: crm.objects.contacts.write/read, crm.objects.deals.write/read,
# crm.schemas.deals.write (for the one-time property setup script).
HUBSPOT_ACCESS_TOKEN=pat-xxxxxxxxxxxxxxxxxxxxxxxx

# Required. Comma-separated list of origins allowed to call this API.
# Requests from any other origin are rejected.
CORS_ORIGIN=https://yoursite.webflow.io,https://yoursite.com

# Optional sanity bounds on the computed quote total (sum of price x qty
# across quoteItems), to reject obviously tampered or garbage values before
# creating a Stripe session.
MIN_QUOTE_TOTAL=1
MAX_QUOTE_TOTAL=1000000

# Optional cap on how many line items a single quoteItems array may contain
MAX_QUOTE_ITEMS=50
